---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import * as fs from 'node:fs';
import * as path from 'node:path';

import LearningTree from '../../components/LearningTree.astro';

const posts = await getCollection('learning');

// First, build a map from lowercase path to correct case path using file system
const learningDir = path.join(process.cwd(), 'src/content/learning');
const pathCaseMap = new Map<string, string>();

function buildPathMap(dir: string, basePath: string = '') {
	const entries = fs.readdirSync(dir, { withFileTypes: true });

	for (const entry of entries) {
		const fullPath = path.join(dir, entry.name);
		const currentPath = basePath ? `${basePath}/${entry.name}` : entry.name;
		const lowercasePath = currentPath.toLowerCase();

		pathCaseMap.set(lowercasePath, currentPath);

		if (entry.isDirectory() && !entry.name.endsWith('.assets')) {
			buildPathMap(fullPath, currentPath);
		}
	}
}

buildPathMap(learningDir);

// Helper to get correct case for a path part
function getCorrectCasePart(parts: string[], index: number): string {
	const pathSoFar = parts.slice(0, index + 1).join('/');
	const correctPath = pathCaseMap.get(pathSoFar.toLowerCase());
	if (correctPath) {
		const correctParts = correctPath.split('/');
		return correctParts[correctParts.length - 1];
	}
	return parts[index];
}

// Build directory tree with correct case
const tree: Record<string, any> = {};

posts.forEach((post) => {
	const parts = post.id.split('/');
	let current = tree;

	parts.forEach((part, index) => {
		// Get the correct case for this part
		const correctPart = getCorrectCasePart(parts, index);

		if (index === parts.length - 1) {
			// File
			current[correctPart] = {
				type: 'file',
				data: post,
				name: correctPart
			};
		} else {
			// Directory
			if (!current[correctPart]) {
				current[correctPart] = {
					type: 'directory',
					children: {},
					name: correctPart
				};
			}
			current = current[correctPart].children;
		}
	});
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`学习中心 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			/* Styling handled in LearningTree component or global styles */
			:global(.learning-tree) {
				font-size: 1.1em;
			}
			:global(.learning-tree ul) {
				list-style: none;
				padding-left: 1.5em;
				margin: 0.5em 0;
			}
			:global(.learning-tree > ul) {
				padding-left: 0;
			}
			:global(.learning-tree li) {
				margin: 0.5em 0;
			}
			:global(.learning-tree summary) {
				cursor: pointer;
				padding: 0.2em 0.5em;
				border-radius: 4px;
				transition: background-color 0.2s;
				user-select: none;
				font-weight: bold;
				color: var(--text-heading);
			}
			:global(.learning-tree summary:hover) {
				background-color: var(--gray-light);
			}
			:global(.learning-tree a) {
				display: inline-flex;
				align-items: center;
				padding: 0.2em 0.5em;
				border-radius: 4px;
				text-decoration: none;
				color: var(--text-main);
				transition: all 0.2s;
			}
			:global(.learning-tree a:hover) {
				background-color: var(--gray-light);
				color: var(--accent);
			}
			:global(.icon) {
				margin-right: 0.5em;
				display: inline-block;
				width: 1.2em;
				text-align: center;
			}
			.page-header {
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--gray-light);
			}
			.page-header h1 {
				margin: 0;
			}
			.page-header p {
				color: var(--gray);
				margin-top: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>学习中心</h1>
				<p>知识库与教程文档</p>
			</div>
			<div class="learning-tree">
				<ul>
					<LearningTree nodes={Object.values(tree)} />
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>