---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import SearchComponent from '../components/react/Search';
import { getCollection } from 'astro:content';
import { resolveImage } from '../utils/resolveImage';

const posts = await getCollection('blog');
const searchIndex = await Promise.all(
	posts.map(async (post) => {
		const image = await resolveImage(post.data.heroImage);
		return {
			id: post.id,
			slug: post.id,
			title: post.data.title,
			description: post.data.description,
			pubDate: post.data.pubDate.toISOString(),
			tags: post.data.tags,
			heroImage: image?.src ?? '',
		};
	}),
);

searchIndex.sort((a, b) => Date.parse(b.pubDate) - Date.parse(a.pubDate));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`搜索 - ${SITE_TITLE}`} description="按标题、描述或标签搜索博客文章" />
		<style>
			main {
				width: 960px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>搜索文章</h1>
			<SearchComponent posts={searchIndex} client:load />
		</main>
		<Footer />
	</body>
</html>
