---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { resolveImage } from '../../utils/resolveImage';
import SpotlightCard from '../../components/react/SpotlightCard';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsWithImages = await Promise.all(posts.map(async (post) => ({
	...post,
	resolvedHeroImage: await resolveImage(post.data.heroImage)
})));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				/* Remove default li behavior if any, but maintain width */
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			/* Update first child specific styles to target the SpotlightCard if needed */
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			
			/* Adjust image styling to work within SpotlightCard */
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				width: 100%;
				height: 200px;
				object-fit: cover;
				display: block;
			}

			/* Reset link display to block to fill the card */
			ul li a {
				display: block;
				height: 100%;
				padding: 1.5rem; /* Match index.astro padding */
				text-decoration: none;
				color: inherit;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: var(--text-heading);
				line-height: 1.2;
				font-size: 1.25rem;
				font-weight: 700;
			}
			.date {
				margin: 0;
				color: var(--text-muted);
			}
			.meta {
				display: flex;
				gap: 0.5em;
				color: var(--text-muted);
				font-size: 0.9em;
				margin-bottom: 0.5em;
			}
			.tags {
				display: flex;
				gap: 0.5rem;
				margin-top: 0.5em;
			}
			.tag {
				font-size: 0.75em;
				background: var(--tag-bg);
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
				color: var(--tag-text);
				transition: all 0.2s ease;
				text-decoration: none;
			}
			.tag:hover {
				background: var(--accent);
				color: white;
			}
			.description {
				margin: 0;
				font-size: 0.95rem;
				color: var(--text-secondary);
				line-height: 1.5;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: inherit; /* SpotlightCard handles hover effects differently or relies on child hover */
			}
			/* Override SpotlightCard internal link hover if needed, or rely on card hover */
			
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.35rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						postsWithImages.map((post) => (
							<li>
                                <SpotlightCard client:visible>
                                    <a href={`/blog/${post.id}/`}>
                                        {post.resolvedHeroImage && (
                                            <Image width={720} height={360} src={post.resolvedHeroImage} alt="" />
                                        )}
                                        <h4 class="title">{post.data.title}</h4>
                                        <div class="meta">
                                            <p class="date">
                                                <FormattedDate date={post.data.pubDate} />
                                            </p>
                                            {post.data.editor && <span class="editor"> • Ed: {post.data.editor}</span>}
                                        </div>
                                        <p class="description">{post.data.description}</p>
                                        {post.data.tags && (
                                            <div class="tags">
                                                {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
                                            </div>
                                        )}
                                    </a>
                                </SpotlightCard>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
